@* Output metrics (#352, FR-MA-3, NFR-MA-3). Trimmed to the mockup's values: dimensions,
   volume and surface area measured from the mesh, a density the member can edit (pre-filled
   from the file when it stores one), and mass = volume x density. Centre of mass, solids/faces, surface types, source units,
   mesh stats and the load-time table were removed per the issue; load time is kept as one
   line in Viewer3D's status bar instead (NFR-MA-2 evidence). *@

<div class="tt-summary">
    <h3>Dimensions <span class="tt-unit">mm</span></h3>
    <table class="tt-table">
        <tr><th>X</th><td>@Mm(Measurements.Size[0])</td></tr>
        <tr><th>Y</th><td>@Mm(Measurements.Size[1])</td></tr>
        <tr><th>Z</th><td>@Mm(Measurements.Size[2])</td></tr>
    </table>
    <p class="tt-note">Measured from the 3D mesh, accuracy ±0.5 mm (NFR-MA-3).</p>

    <h3>Volume and mass</h3>
    <table class="tt-table">
        <tr><th>Volume</th><td>@N(Measurements.VolumeMm3 / 1000, 2) cm³</td></tr>
        <tr><th>Surface area</th><td>@N(Measurements.SurfaceAreaMm2 / 100, 2) cm²</td></tr>
        <tr>
            <th>Density</th>
            <td><input class="tt-num" type="number" step="0.01" min="0" @bind="Density" @bind:event="oninput" /> g/cm³</td>
        </tr>
        <tr>
            <th>Mass</th>
            <td><strong>@(Density is > 0 ? $"{N(Measurements.VolumeMm3 / 1000 * Density.Value, 2)} g" : "—")</strong></td>
        </tr>
    </table>

    @if (!Measurements.Closed)
    {
        <p class="tt-warn">The surface is not closed, so volume and mass may be wrong.</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public required StoredModel Model { get; set; }
    [Parameter, EditorRequired] public required MeshMeasurements Measurements { get; set; }

    private double? Density { get; set; }
    private Guid? _densitySourceId;

    protected override void OnParametersSet()
    {
        // Reset the density only when a different model is loaded, not on every re-render.
        if (_densitySourceId != Model.Id)
        {
            _densitySourceId = Model.Id;
            Density = Model.Inspection.DensityGPerCm3;
        }
    }

    private static string N(double v, int digits) => v.ToString("N" + digits, CultureInfo.InvariantCulture);
    private static string Mm(double v) => N(Math.Abs(v) < 0.005 ? 0 : v, 2);
}
